# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist

# wrangler's local state and build output for the relay
.wrangler
dist-ssr
*.local

